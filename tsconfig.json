{
	"compilerOptions": {
		"target": "ESNext",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ESNext", "DOM"],
		"allowJs": true,
		"checkJs": true,
		"strict": false,
		"noImplicitAny": false,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"maxNodeModuleJsDepth": 1
	},
	"include": ["packages/**/*", "testing-app/**/*", "scripts/**/*"],
	"exclude": ["node_modules", "**/node_modules", "**/.next", "**/dist", "**/types", ".artifacts"]
}
