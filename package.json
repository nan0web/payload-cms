{
  "name": "@nan0web/payload-cms",
  "version": "0.1.0",
  "description": "Monorepo workspace for @nan0web/payload-* plugins suite and testing sandbox for Payload CMS 3.x.",
  "private": true,
  "type": "module",
  "scripts": {
    "help": "node bin/help.js",
    "dev:help": "node bin/help.js",
    "dev": "pnpm --filter testing-app dev",
    "dev:storage": "PLUGINS=self-storage pnpm --filter testing-app dev",
    "dev:folder": "PLUGINS=browse-by-folder pnpm --filter testing-app dev",
    "dev:keyboard": "PLUGINS=keyboard-accessibility pnpm --filter testing-app dev",
    "dev:theme": "PLUGINS=signin-theme-state pnpm --filter testing-app dev",
    "dev:manual": "PLUGINS=self-manual pnpm --filter testing-app dev",
    "build": "pnpm --filter testing-app build",
    "start": "pnpm --filter testing-app start",
    "dev:prod": "pnpm --filter testing-app dev:prod",
    "pack": "node bin/pack.js",
    "pack:all": "node bin/pack.js --all",
    "publish:all": "pnpm --filter \"@nan0web/payload-*\" publish --access public",
    "check:context": "node scripts/check-llm-context.js",
    "build:llms-full": "node scripts/build-llm-context.js"
  },
  "devDependencies": {
    "@nan0web/ui-cli": "^3.2.0"
  }
}
