{
  "name": "@nan0web/payload-mail-tester",
  "version": "0.1.0",
  "description": "Universal mail adapter (sendmail / SMTP / mock) with Admin diagnostic tester for Payload CMS 3.x.",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nan0web/payload-cms.git",
    "directory": "packages/payload-mail-tester"
  },
  "bugs": {
    "url": "https://github.com/nan0web/payload-cms/issues"
  },
  "homepage": "https://github.com/nan0web/payload-cms/tree/main/packages/payload-mail-tester#readme",
  "keywords": [
    "payload",
    "payloadcms",
    "email",
    "mail-tester",
    "nodemailer",
    "sendmail",
    "smtp"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./admin": "./src/admin.jsx"
  },
  "files": [
    "src",
    "docs",
    "releases",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "knip": "pnpm dlx knip --production",
    "test:releases": "node --test --test-timeout=9999 'releases/**/*.spec.js'",
    "test": "node --test --test-timeout=9999 'tests/**/*.test.js' 'src/**/*.test.js' 'releases/**/*.spec.js'",
    "test:e2e": "node --test --test-name-pattern=e2e",
    "pack:check": "pnpm pack --pack-destination .artifacts",
    "pack:local": "pnpm pack --pack-destination .artifacts",
    "test:all": "pnpm test && pnpm knip"
  },
  "peerDependencies": {
    "payload": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@nan0web/types": "^3.4.0",
    "nodemailer": "^6.9.16 || ^9.0.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^5.61.0"
  }
}
