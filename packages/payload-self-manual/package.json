{
  "name": "@nan0web/payload-self-manual",
  "version": "0.1.0",
  "description": "In-admin Markdown documentation viewer with Mermaid support for Payload CMS.",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nan0web/payload-cms.git",
    "directory": "packages/payload-self-manual"
  },
  "bugs": {
    "url": "https://github.com/nan0web/payload-cms/issues"
  },
  "homepage": "https://github.com/nan0web/payload-cms/tree/main/packages/payload-self-manual#readme",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./admin": "./src/admin.jsx"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "knip": "pnpm dlx knip --production",
    "test:releases": "node --test --test-timeout=9999 'tests/**/*.test.js'",
    "test": "node --test --test-timeout=9999 'tests/**/*.test.js' 'src/**/*.test.js'",
    "test:e2e": "node --test --test-name-pattern=e2e",
    "test:all": "pnpm test && pnpm knip && pnpm audit",
    "pack:check": "pnpm pack --pack-destination .artifacts",
    "pack:local": "pnpm pack --pack-destination .artifacts"
  },
  "peerDependencies": {
    "payload": ">=3.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^5.61.0"
  }
}
