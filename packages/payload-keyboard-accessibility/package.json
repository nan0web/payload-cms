{
  "name": "@nan0web/payloadcms-keyboard-accessibility",
  "version": "0.1.1",
  "description": "Keyboard focus and submit shortcuts for Payload CMS Admin forms.",
  "type": "module",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nan0web/payload-cms.git",
    "directory": "packages/payload-keyboard-accessibility"
  },
  "bugs": {
    "url": "https://github.com/nan0web/payload-cms/issues"
  },
  "homepage": "https://github.com/nan0web/payload-cms/tree/main/packages/payload-keyboard-accessibility#readme",
  "keywords": [
    "payload",
    "payloadcms",
    "accessibility",
    "keyboard",
    "focus",
    "react"
  ],
  "files": [
    "src",
    "README.md",
    "docs",
    "LICENSE"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./admin": "./src/admin.js"
  },
  "scripts": {
    "knip": "pnpm dlx knip --production",
    "test:releases": "node --test --test-timeout=9999 'tests/**/*.test.js'",
    "test": "node --test --test-timeout=9999 'tests/**/*.test.js' 'src/**/*.test.js'",
    "test:e2e": "node --test --test-name-pattern=e2e",
    "pack:check": "pnpm pack --pack-destination .artifacts",
    "pack:local": "pnpm pack --pack-destination .artifacts",
    "test:all": "pnpm test && pnpm knip && pnpm audit"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^5.61.0"
  },
  "peerDependencies": {
    "payload": ">=3.0.0",
    "react": ">=18.0.0"
  }
}
