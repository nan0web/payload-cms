{
	"name": "@nan0web/payload-self-storage",
	"version": "0.2.0",
	"description": "Self-hosted filesystem storage adapter and backup foundation for Payload CMS.",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nan0web/payload-cms.git",
		"directory": "packages/payload-self-storage"
	},
	"bugs": {
		"url": "https://github.com/nan0web/payload-cms/issues"
	},
	"homepage": "https://github.com/nan0web/payload-cms/tree/main/packages/payload-self-storage#readme",
	"keywords": [
		"payload",
		"payloadcms",
		"storage",
		"filesystem",
		"backup"
	],
	"files": [
		"src",
		"test",
		"releases",
		"docs",
		"README.md",
		"LICENSE"
	],
	"type": "module",
	"main": "./src/index.js",
	"types": "./types/index.d.ts",
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"import": "./src/index.js"
		},
		"./storage": {
			"types": "./types/storage/index.d.ts",
			"import": "./src/storage/index.js"
		},
		"./payload": {
			"types": "./types/payload/index.d.ts",
			"import": "./src/payload/index.js"
		}
	},
	"scripts": {
		"prebuild": "rm -rf types/",
		"build": "tsc",
		"test:releases": "node --test --test-timeout=9999 'releases/**/*.spec.js'",
		"test": "node --test --test-timeout=9999 'src/**/*.test.js' 'test/**/*.test.js'",
		"test:e2e": "node --test --test-name-pattern=e2e",
		"pack:check": "pnpm pack --pack-destination .artifacts",
		"pack:local": "pnpm pack --pack-destination .artifacts",
		"knip": "knip --production",
		"audit": "pnpm audit --audit-level=high || true",
		"test:all": "pnpm test && pnpm build && pnpm knip && pnpm run audit"
	},
	"engines": {
		"node": ">=20"
	},
	"peerDependencies": {
		"payload": ">=3.0.0",
		"sharp": ">=0.33.0"
	},
	"peerDependenciesMeta": {
		"sharp": {
			"optional": true
		}
	},
	"devDependencies": {
		"knip": "^5.61.0"
	}
}
